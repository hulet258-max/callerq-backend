# DATABASE_URL is generated from the local PostgreSQL variables below.
PGHOST=localhost
PGPORT=5432
PGDATABASE=callerq
PGUSER=postgres
PGPASSWORD=postgres
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
HOST="0.0.0.0"
PORT=8000
CLIENT_URL="*"
NODE_ENV="development"
# Base64-encoded Firebase service-account JSON. Leave blank to run without push delivery.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=""
# Local alternative to the Base64 variable. Do not commit the referenced JSON.
FIREBASE_SERVICE_ACCOUNT_PATH=""
# Trusted receipt-verification service called by src/services/deposit.js.
# It must return JSON with valid=true, an amount, and a transaction identifier.
PAYMENT_VERIFICATION_URL=""
PAYMENT_VERIFICATION_API_KEY=""
SUBSCRIPTION_MONTHLY_BIRR=150
SUBSCRIPTION_PAYMENT_INSTRUCTIONS="Pay securely with Chapa without leaving the app."
# Replace this placeholder with the secret key from your Chapa dashboard.
# Never put the secret key in the Flutter app or commit a real key.
CHAPA_SECRET_KEY="CHASECK_TEST-PLACEHOLDER"
# HTTPS page intercepted by the in-app checkout after Chapa redirects.
CHAPA_RETURN_URL="https://callerq-callerq-backend.v3rao3.easypanel.host/api/v1/public/chapa/return"
# Public HTTPS origin of this backend (no trailing slash), used by Chapa callbacks.
PUBLIC_BASE_URL="https://callerq-callerq-backend.v3rao3.easypanel.host"
