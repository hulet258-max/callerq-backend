# DATABASE_URL is generated from the local PostgreSQL variables below.
PGHOST=localhost
PGPORT=5432
PGDATABASE=callerq
PGUSER=postgres
PGPASSWORD=postgres
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
HOST="0.0.0.0"
PORT=8000
CLIENT_URL="*"
NODE_ENV="development"
# Base64-encoded Firebase service-account JSON. Leave blank to run without push delivery.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=""
# Local alternative to the Base64 variable. Do not commit the referenced JSON.
FIREBASE_SERVICE_ACCOUNT_PATH=""
