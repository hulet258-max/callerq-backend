{
  "name": "minot-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST and Socket.IO API for the ምኞት smart salon queue MVP",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "test": "node --test",
    "prisma:generate": "node --import ./src/config/env.js ./node_modules/prisma/build/index.js generate",
    "db:migrate": "node --import ./src/config/env.js ./node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --import ./src/config/env.js ./node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --import ./src/config/env.js ./node_modules/prisma/build/index.js db seed"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prisma": "6.19.3",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
