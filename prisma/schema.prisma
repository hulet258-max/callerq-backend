generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUSINESS_OWNER
  STAFF
  ADMIN
}

enum BusinessType {
  BARBER_SHOP
  WOMENS_SALON
  UNISEX_SALON
  BEAUTY_SPA
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ServiceCategory {
  HAIR
  BEARD
  MAKEUP
  NAILS
  FACIAL
  SPA
  OTHER
}

enum StaffStatus {
  AVAILABLE
  BUSY
  OFF_DUTY
  ON_BREAK
}

enum CommissionType {
  NONE
  PERCENTAGE
  FIXED
}

enum QueueStatus {
  WAITING
  ARRIVED
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
  SKIPPED
}

enum QueueSource {
  SIMULATED_CALL
  MANUAL_ADD
  APPOINTMENT
  WALK_IN
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ARRIVED
  ADDED_TO_QUEUE
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum TemplateType {
  QUEUE_CONFIRMATION
  NEXT_CUSTOMER
  DELAY
  APPOINTMENT_REMINDER
  CANCELLATION
  THANK_YOU
  PROMOTION
}

enum NotificationType {
  QUEUE
  APPOINTMENT
  PAYMENT
  PROMOTION
  GENERAL
}

enum NotificationChannel {
  SMS
  WHATSAPP
  TELEGRAM
  MANUAL_CALL
  APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum PaymentMethod {
  CASH
  TELEBIRR
  BANK
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String
  phone        String   @unique
  email        String?  @unique
  passwordHash String
  role         UserRole @default(BUSINESS_OWNER)
  isActive     Boolean  @default(true)
  business     Business?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
  @@map("users")
}

model Business {
  id               String            @id @default(uuid()) @db.Uuid
  ownerId          String            @unique @db.Uuid
  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name             String
  type             BusinessType
  phone            String
  city             String?
  address          String?
  description      String?
  openingTime      String?
  closingTime      String?
  staff            Staff[]
  services         Service[]
  customers        Customer[]
  queueEntries     QueueEntry[]
  queueHistory     QueueStatusHistory[]
  appointments     Appointment[]
  messageTemplates MessageTemplate[]
  notifications    Notification[]
  payments         Payment[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([phone])
  @@index([createdAt])
  @@map("businesses")
}

model Staff {
  id              String         @id @default(uuid()) @db.Uuid
  businessId      String         @db.Uuid
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fullName        String
  phone           String
  role            String
  status          StaffStatus    @default(AVAILABLE)
  commissionType  CommissionType @default(NONE)
  commissionValue Decimal        @default(0) @db.Decimal(12, 2)
  favoriteFor     Customer[]     @relation("FavoriteStaff")
  queueEntries    QueueEntry[]
  appointments    Appointment[]
  payments        Payment[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([businessId, phone])
  @@index([businessId])
  @@index([createdAt])
  @@map("staff")
}

model Service {
  id              String          @id @default(uuid()) @db.Uuid
  businessId      String          @db.Uuid
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  category        ServiceCategory @default(OTHER)
  description     String?
  price           Decimal         @db.Decimal(12, 2)
  durationMinutes Int
  isActive        Boolean         @default(true)
  favoriteFor     Customer[]      @relation("FavoriteService")
  queueEntries    QueueEntry[]
  appointments    Appointment[]
  payments        Payment[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([businessId])
  @@index([createdAt])
  @@map("services")
}

model Customer {
  id                String        @id @default(uuid()) @db.Uuid
  businessId        String        @db.Uuid
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fullName          String
  phone             String
  gender            Gender?
  notes             String?
  favoriteServiceId String?       @db.Uuid
  favoriteService   Service?      @relation("FavoriteService", fields: [favoriteServiceId], references: [id], onDelete: SetNull)
  favoriteStaffId   String?       @db.Uuid
  favoriteStaff     Staff?        @relation("FavoriteStaff", fields: [favoriteStaffId], references: [id], onDelete: SetNull)
  vip               Boolean       @default(false)
  noShowCount       Int           @default(0)
  totalVisits       Int           @default(0)
  totalSpending     Decimal       @default(0) @db.Decimal(12, 2)
  lastVisitAt       DateTime?
  queueEntries      QueueEntry[]
  appointments      Appointment[]
  notifications     Notification[]
  payments          Payment[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([businessId, phone])
  @@index([businessId])
  @@index([phone])
  @@index([createdAt])
  @@map("customers")
}

model QueueEntry {
  id                   String               @id @default(uuid()) @db.Uuid
  businessId           String               @db.Uuid
  business             Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId           String               @db.Uuid
  customer             Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  serviceId            String               @db.Uuid
  service              Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staffId              String?              @db.Uuid
  staff                Staff?               @relation(fields: [staffId], references: [id], onDelete: SetNull)
  queueNumber          Int
  status               QueueStatus          @default(WAITING)
  source               QueueSource          @default(MANUAL_ADD)
  estimatedWaitMinutes Int                  @default(0)
  estimatedStartTime   DateTime?
  actualStartTime      DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  noShowAt             DateTime?
  notes                String?
  history              QueueStatusHistory[]
  notifications        Notification[]
  payments             Payment[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([createdAt])
  @@map("queue_entries")
}

model QueueStatusHistory {
  id           String      @id @default(uuid()) @db.Uuid
  businessId   String      @db.Uuid
  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  queueEntryId String      @db.Uuid
  queueEntry   QueueEntry  @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  fromStatus   QueueStatus?
  toStatus     QueueStatus
  notes        String?
  createdAt    DateTime    @default(now())

  @@index([businessId])
  @@index([queueEntryId])
  @@index([createdAt])
  @@map("queue_status_history")
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  businessId      String            @db.Uuid
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId      String            @db.Uuid
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  serviceId       String            @db.Uuid
  service         Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staffId         String?           @db.Uuid
  staff           Staff?            @relation(fields: [staffId], references: [id], onDelete: SetNull)
  appointmentDate DateTime          @db.Date
  startTime       String
  endTime         String
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?
  reminderSent    Boolean           @default(false)
  notifications   Notification[]
  payments        Payment[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([businessId])
  @@index([businessId, appointmentDate])
  @@index([appointmentDate])
  @@index([createdAt])
  @@map("appointments")
}

model MessageTemplate {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @db.Uuid
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       TemplateType
  title      String
  body       String
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([businessId, type])
  @@index([businessId])
  @@index([createdAt])
  @@map("message_templates")
}

model Notification {
  id            String               @id @default(uuid()) @db.Uuid
  businessId    String               @db.Uuid
  business      Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String?              @db.Uuid
  customer      Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  queueEntryId  String?              @db.Uuid
  queueEntry    QueueEntry?          @relation(fields: [queueEntryId], references: [id], onDelete: SetNull)
  appointmentId String?              @db.Uuid
  appointment   Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  type          NotificationType     @default(GENERAL)
  channel       NotificationChannel  @default(SMS)
  title         String
  message       String
  status        NotificationStatus   @default(PENDING)
  sentAt        DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([businessId])
  @@index([businessId, status])
  @@index([createdAt])
  @@map("notifications")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  businessId      String        @db.Uuid
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId      String        @db.Uuid
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  queueEntryId    String?       @db.Uuid
  queueEntry      QueueEntry?   @relation(fields: [queueEntryId], references: [id], onDelete: SetNull)
  appointmentId   String?       @db.Uuid
  appointment     Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  serviceId       String?       @db.Uuid
  service         Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  staffId         String?       @db.Uuid
  staff           Staff?        @relation(fields: [staffId], references: [id], onDelete: SetNull)
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  referenceNumber String?
  notes           String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([businessId])
  @@index([businessId, paymentStatus])
  @@index([createdAt])
  @@map("payments")
}
