generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUSINESS_OWNER
  ADMIN
}

enum BusinessType {
  BARBER_SHOP
  WOMENS_SALON
  UNISEX_SALON
  BEAUTY_SPA
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ServiceCategory {
  HAIR
  BEARD
  MAKEUP
  NAILS
  FACIAL
  SPA
  OTHER
}

enum QueueStatus {
  WAITING
  ARRIVED
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
  SKIPPED
}

enum QueueSource {
  SIMULATED_CALL
  MANUAL_ADD
  APPOINTMENT
  WALK_IN
}

enum AppointmentStatus {
  REQUESTED
  SCHEDULED
  CONFIRMED
  ARRIVED
  ADDED_TO_QUEUE
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
  DECLINED
}

enum AppointmentSource {
  OWNER
  CUSTOMER_APP
}

enum TemplateType {
  QUEUE_CONFIRMATION
  NEXT_CUSTOMER
  DELAY
  APPOINTMENT_REMINDER
  CANCELLATION
  THANK_YOU
  PROMOTION
}

enum NotificationType {
  QUEUE
  APPOINTMENT
  PAYMENT
  PROMOTION
  GENERAL
}

enum NotificationChannel {
  SMS
  WHATSAPP
  TELEGRAM
  MANUAL_CALL
  APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationAudience {
  BUSINESS
  CUSTOMER
}

enum PushPlatform {
  ANDROID
  IOS
}

enum PaymentMethod {
  CASH
  TELEBIRR
  BANK
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum SubscriptionInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  fullName                String
  phone                   String                   @unique
  email                   String?                  @unique
  passwordHash            String?
  googleUid               String?                  @unique
  role                    UserRole                 @default(BUSINESS_OWNER)
  isActive                Boolean                  @default(true)
  business                Business?
  pushDevices             UserPushDevice[]
  appointmentResponses    Appointment[]            @relation("AppointmentResponder")
  callerDirectoryContacts CallerDirectoryContact[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([createdAt])
  @@map("users")
}

model CallerDirectoryContact {
  id              String   @id @default(uuid()) @db.Uuid
  contributorId   String   @db.Uuid
  contributor     User     @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  normalizedPhone String
  displayName     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([contributorId, normalizedPhone])
  @@index([normalizedPhone])
  @@map("caller_directory_contacts")
}

model Business {
  id                    String                @id @default(uuid()) @db.Uuid
  ownerId               String                @unique @db.Uuid
  owner                 User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                  String
  type                  BusinessType
  phone                 String
  city                  String?
  address               String?
  description           String?
  profileImageUrl       String?
  profileImageFileName  String?
  openingTime           String?
  closingTime           String?
  socialLinks           Json?
  latitude              Float?
  longitude             Float?
  isActive              Boolean               @default(true)
  isOpen                Boolean               @default(true)
  isApproved            Boolean               @default(true)
  isSuspended           Boolean               @default(false)
  subscriptionStatus    SubscriptionStatus    @default(ACTIVE)
  subscriptionInterval  SubscriptionInterval?
  subscriptionExpiresAt DateTime?
  deletedAt             DateTime?
  services              Service[]
  customers             Customer[]
  queueEntries          QueueEntry[]
  queueHistory          QueueStatusHistory[]
  appointments          Appointment[]
  messageTemplates      MessageTemplate[]
  notifications         Notification[]
  payments              Payment[]
  reviews               Review[]
  subscriptionPayments  SubscriptionPayment[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([phone])
  @@index([isActive, isApproved, isSuspended, deletedAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([address(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([createdAt])
  @@map("businesses")
}

model SubscriptionPayment {
  id            String               @id @default(uuid()) @db.Uuid
  businessId    String               @db.Uuid
  business      Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  interval      SubscriptionInterval
  amount        Decimal              @db.Decimal(12, 2)
  transactionId String               @unique
  receiptCode   String?
  receiptInput  String
  verifiedAt    DateTime             @default(now())
  startsAt      DateTime
  expiresAt     DateTime
  createdAt     DateTime             @default(now())

  @@index([businessId, createdAt])
  @@map("subscription_payments")
}

model Service {
  id              String          @id @default(uuid()) @db.Uuid
  businessId      String          @db.Uuid
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  category        ServiceCategory @default(OTHER)
  description     String?
  price           Decimal         @db.Decimal(12, 2)
  durationMinutes Int
  isActive        Boolean         @default(true)
  favoriteFor     Customer[]      @relation("FavoriteService")
  queueEntries    QueueEntry[]
  appointments    Appointment[]
  payments        Payment[]
  images          ServiceImage[]
  reviews         Review[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([businessId])
  @@index([createdAt])
  @@map("services")
}

model Customer {
  id                String         @id @default(uuid()) @db.Uuid
  businessId        String         @db.Uuid
  business          Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fullName          String
  phone             String
  normalizedPhone   String
  gender            Gender?
  notes             String?
  favoriteServiceId String?        @db.Uuid
  favoriteService   Service?       @relation("FavoriteService", fields: [favoriteServiceId], references: [id], onDelete: SetNull)
  vip               Boolean        @default(false)
  noShowCount       Int            @default(0)
  totalVisits       Int            @default(0)
  totalSpending     Decimal        @default(0) @db.Decimal(12, 2)
  lastVisitAt       DateTime?
  queueEntries      QueueEntry[]
  appointments      Appointment[]
  notifications     Notification[]
  payments          Payment[]
  reviews           Review[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([businessId, phone])
  @@unique([businessId, normalizedPhone])
  @@index([businessId])
  @@index([phone])
  @@index([createdAt])
  @@map("customers")
}

model QueueEntry {
  id                   String               @id @default(uuid()) @db.Uuid
  businessId           String               @db.Uuid
  business             Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId           String               @db.Uuid
  customer             Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  serviceId            String               @db.Uuid
  service              Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  queueNumber          Int
  status               QueueStatus          @default(WAITING)
  source               QueueSource          @default(MANUAL_ADD)
  estimatedWaitMinutes Int                  @default(0)
  estimatedStartTime   DateTime?
  actualStartTime      DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  noShowAt             DateTime?
  notes                String?
  appointmentId        String?              @unique @db.Uuid
  appointment          Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  history              QueueStatusHistory[]
  notifications        Notification[]
  payments             Payment[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([createdAt])
  @@map("queue_entries")
}

model QueueStatusHistory {
  id           String       @id @default(uuid()) @db.Uuid
  businessId   String       @db.Uuid
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  queueEntryId String       @db.Uuid
  queueEntry   QueueEntry   @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  fromStatus   QueueStatus?
  toStatus     QueueStatus
  notes        String?
  createdAt    DateTime     @default(now())

  @@index([businessId])
  @@index([queueEntryId])
  @@index([createdAt])
  @@map("queue_status_history")
}

model Appointment {
  id                String                @id @default(uuid()) @db.Uuid
  businessId        String                @db.Uuid
  business          Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId        String                @db.Uuid
  customer          Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  serviceId         String                @db.Uuid
  service           Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  appointmentDate   DateTime              @db.Date
  startTime         String
  endTime           String
  status            AppointmentStatus     @default(SCHEDULED)
  source            AppointmentSource     @default(OWNER)
  notes             String?
  responseReason    String?
  responseNote      String?
  respondedAt       DateTime?
  respondedById     String?               @db.Uuid
  respondedBy       User?                 @relation("AppointmentResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  requesterDeviceId String?               @db.Uuid
  requesterDevice   PushDevice?           @relation(fields: [requesterDeviceId], references: [id], onDelete: SetNull)
  queueEntry        QueueEntry?
  notifications     Notification[]
  payments          Payment[]
  reminders         AppointmentReminder[]
  review            Review?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([businessId])
  @@index([businessId, appointmentDate])
  @@index([businessId, appointmentDate, startTime])
  @@index([appointmentDate])
  @@index([createdAt])
  @@map("appointments")
}

model MessageTemplate {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @db.Uuid
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       TemplateType
  title      String
  body       String
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([businessId, type])
  @@index([businessId])
  @@index([createdAt])
  @@map("message_templates")
}

model Notification {
  id            String               @id @default(uuid()) @db.Uuid
  businessId    String               @db.Uuid
  business      Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String?              @db.Uuid
  customer      Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  queueEntryId  String?              @db.Uuid
  queueEntry    QueueEntry?          @relation(fields: [queueEntryId], references: [id], onDelete: SetNull)
  appointmentId String?              @db.Uuid
  appointment   Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  type          NotificationType     @default(GENERAL)
  channel       NotificationChannel  @default(SMS)
  title         String
  message       String
  status        NotificationStatus   @default(PENDING)
  audience      NotificationAudience @default(BUSINESS)
  sentAt        DateTime?
  deliveries    PushDelivery[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([businessId])
  @@index([businessId, status])
  @@index([createdAt])
  @@map("notifications")
}

model PushDevice {
  id             String           @id @default(uuid()) @db.Uuid
  installationId String           @unique
  fcmToken       String           @unique
  platform       PushPlatform     @default(ANDROID)
  enabled        Boolean          @default(true)
  lastSeenAt     DateTime         @default(now())
  users          UserPushDevice[]
  appointments   Appointment[]
  deliveries     PushDelivery[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([enabled])
  @@map("push_devices")
}

model UserPushDevice {
  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String     @db.Uuid
  device    PushDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([userId, deviceId])
  @@index([deviceId])
  @@map("user_push_devices")
}

model PushDelivery {
  id                String             @id @default(uuid()) @db.Uuid
  notificationId    String             @db.Uuid
  notification      Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  deviceId          String             @db.Uuid
  device            PushDevice         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  status            NotificationStatus @default(PENDING)
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([notificationId, deviceId])
  @@index([deviceId, status])
  @@map("push_deliveries")
}

enum ReminderKind {
  DAY_BEFORE
  MINUTES_30
  MINUTES_15
}

model AppointmentReminder {
  id            String       @id @default(uuid()) @db.Uuid
  appointmentId String       @db.Uuid
  appointment   Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  kind          ReminderKind
  sentAt        DateTime?
  createdAt     DateTime     @default(now())

  @@unique([appointmentId, kind])
  @@index([sentAt])
  @@map("appointment_reminders")
}

model ServiceImage {
  id        String   @id @default(uuid()) @db.Uuid
  serviceId String   @db.Uuid
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  url       String
  fileName  String
  caption   String?
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([serviceId, sortOrder])
  @@map("service_images")
}

model Review {
  id            String      @id @default(uuid()) @db.Uuid
  businessId    String      @db.Uuid
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId     String      @db.Uuid
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customerId    String      @db.Uuid
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointmentId String      @unique @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([businessId, createdAt])
  @@index([serviceId])
  @@map("reviews")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  businessId      String        @db.Uuid
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId      String        @db.Uuid
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  queueEntryId    String?       @db.Uuid
  queueEntry      QueueEntry?   @relation(fields: [queueEntryId], references: [id], onDelete: SetNull)
  appointmentId   String?       @db.Uuid
  appointment     Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  serviceId       String?       @db.Uuid
  service         Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  referenceNumber String?
  notes           String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([businessId])
  @@index([businessId, paymentStatus])
  @@index([createdAt])
  @@map("payments")
}
