# Suppercall backend production environment (Easypanel)
NODE_ENV="production"
HOST="0.0.0.0"
PORT="8000"

# Use the production PostgreSQL connection string supplied by the hosting platform.
DATABASE_URL="postgresql://USER:PASSWORD@DATABASE_HOST:5432/callerq?schema=public"
JWT_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
JWT_EXPIRES_IN="7d"
CLIENT_URL="*"

# The public HTTPS backend origin. Do not include /api/v1 or a trailing slash.
PUBLIC_BASE_URL="https://callerq-callerq-backend.v3rao3.easypanel.host"

# Replace this value in Easypanel with the LIVE secret from the Chapa dashboard.
# Never expose it through Flutter --dart-define, source control, or client logs.
CHAPA_SECRET_KEY="CHASECK_LIVE-REPLACE_WITH_YOUR_CHAPA_SECRET_KEY"

# Chapa redirects the in-app WebView here. This route is served by this backend.
CHAPA_RETURN_URL="https://callerq-callerq-backend.v3rao3.easypanel.host/api/v1/public/chapa/return"

SUBSCRIPTION_MONTHLY_BIRR="150"
SUBSCRIPTION_PAYMENT_INSTRUCTIONS="Pay securely with Chapa without leaving the app."

# Optional Firebase push configuration.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=""
FIREBASE_SERVICE_ACCOUNT_PATH=""
